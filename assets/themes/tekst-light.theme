    "editor-colors": {
        "BackgroundColor": "#fcfcfc",
        "CodeFolding": "#94caef",
        "BracketMatching": "#ffff00",
        "CurrentLine": "#f8f7f6",
        "IconBorder": "#f0f0f0",
