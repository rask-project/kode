    "text-styles": {
        "Normal": {
            "text-color": "#0a0a0a",
            "selected-text-color": "#0a0a0a"
        },
        "Keyword": {
            "text-color": "#808000",
            "selected-text-color": "#808000"
        },
        "Function": {
            "text-color": "#00677c",
            "selected-text-color": "#00677c"
        },
        "Variable": {
            "text-color": "#092e64",
            "selected-text-color": "#092e64"
        },
        "ControlFlow": {
            "text-color": "#808000",
            "selected-text-color": "#808000"
        },
        "Operator": {},
        "BuiltIn": {
            "text-color": "#808000",
            "selected-text-color": "#808000"
        },
        "Extension": {
            "text-color": "#ce5c00",
            "selected-text-color": "#ce5c00"
        },
        "Preprocessor": {
            "text-color": "#000080",
            "selected-text-color": "#000080"
        },
        "Attribute": {
            "text-color": "#808000",
            "selected-text-color": "#808000"
        },
        "Char": {
