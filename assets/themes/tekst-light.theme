            "selected-text-color": "#008000"
        },
        "VerbatimString": {
            "text-color": "#008000",
            "selected-text-color": "#008000"
        },
        "SpecialString": {
            "text-color": "#008000",
            "selected-text-color": "#008000"
        },
        "Import": {
            "text-color": "#00677c",
            "selected-text-color": "#00677c"
        },
        "DataType": {
            "text-color": "#800080",
            "selected-text-color": "#800080"
        },
        "DecVal": {
            "text-color": "#000080",
            "selected-text-color": "#000080"
        },
        "BaseN": {
            "text-color": "#000080",
            "selected-text-color": "#000080"
        },
        "Float": {
